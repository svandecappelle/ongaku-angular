{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "module": "esnext",
    "useDefineForClassFields": false,
    "paths": {
      "app/*": [
        "./src/app/*"
      ]
    },
    "strict": false
  }
}
